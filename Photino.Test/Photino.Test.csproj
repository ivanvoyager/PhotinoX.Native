<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ApplicationIcon>wwwroot\photino-logo.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishAot>False</PublishAot>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</IsWindows>
    <IsOSX Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsOSX>
    <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindows)' == 'true'">
    <DefineConstants>$(DefineConstants);Windows</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsOSX)' == 'true'">
    <DefineConstants>$(DefineConstants);OSX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLinux)' == 'true'">
    <DefineConstants>$(DefineConstants);Linux</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PhotinoX_UseLocalProjects)' == 'true'">
    <DefineConstants>$(DefineConstants);UseLocalProjects</DefineConstants>
    <PhotinoNetSourceDir Condition="'$(PhotinoNetSourceDir)' == ''">..\..\PhotinoX\Photino.NET</PhotinoNetSourceDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(PhotinoX_UseLocalProjects)' == 'true'">
    <Compile Include="$(PhotinoNetSourceDir)\Utils\Platform.cs" Link="Utils\Platform.cs" />
    <Compile Include="$(PhotinoNetSourceDir)\Utils\Platform.MacOS.cs" Link="Utils\Platform.MacOS.cs" />
    <Compile Include="$(PhotinoNetSourceDir)\PhotinoDialogEnums.cs" Link="PhotinoDialogEnums.cs" />
    <Compile Include="$(PhotinoNetSourceDir)\PhotinoDllImports.cs" Link="PhotinoDllImports.cs" />
    <Compile Include="$(PhotinoNetSourceDir)\PhotinoMonitorStruct.cs" Link="PhotinoMonitorStruct.cs" />
    <Compile Include="$(PhotinoNetSourceDir)\PhotinoNativeDelegates.cs" Link="PhotinoNativeDelegates.cs" />
    <Compile Include="$(PhotinoNetSourceDir)\PhotinoNativeParameters.cs" Link="PhotinoNativeParameters.cs" />
    <Compile Include="$(PhotinoNetSourceDir)\PhotinoNetDelegates.cs" Link="PhotinoNetDelegates.cs" />
    <Compile Include="$(PhotinoNetSourceDir)\PhotinoWindow.NET.cs" Link="PhotinoWindow.NET.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\main.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wwwroot\photino-logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="wwwroot\photino-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup Condition="'$(PhotinoX_UseLocalProjects)' == 'true' AND '$(IsWindows)' == 'true'">
    <NativePlatform Condition="'$(Platform)' == 'x64'">x64</NativePlatform>
    <NativePlatform Condition="'$(Platform)' == 'ARM64'">ARM64</NativePlatform>
    <NativePlatform Condition="'$(Platform)' == 'AnyCPU'">x64</NativePlatform>

    <NativeRidArch Condition="'$(NativePlatform)' == 'x64'">x64</NativeRidArch>
    <NativeRidArch Condition="'$(NativePlatform)' == 'ARM64'">arm64</NativeRidArch>

    <NativeProjectPath>$(MSBuildProjectDirectory)\..\Photino.Native\Photino.Native.vcxproj</NativeProjectPath>
    <NativeOutputDir>$(MSBuildProjectDirectory)\..\Photino.Native\$(NativePlatform)\$(Configuration)\</NativeOutputDir>
  </PropertyGroup>

  <Target Name="ValidatePhotinoNetSourceDir"
        BeforeTargets="BeforeBuild"
        Condition="'$(PhotinoX_UseLocalProjects)' == 'true'
                   AND '$(DesignTimeBuild)' != 'true'">
    <Error
      Text="PhotinoNetSourceDir does not exist or does not contain PhotinoWindow.NET.cs: $(PhotinoNetSourceDir)"
      Condition="!Exists('$(PhotinoNetSourceDir)\PhotinoWindow.NET.cs')" />
  </Target>

  <Target Name="Photino_BuildNativeWindows"
          BeforeTargets="DispatchToInnerBuilds"
          Condition="'$(PhotinoX_UseLocalProjects)' == 'true'
                   AND '$(IsWindows)' == 'true'
                   AND '$(NativePlatform)' != ''
                   AND '$(IsCrossTargetingBuild)' == 'true'
                   AND '$(DesignTimeBuild)' != 'true'">

    <Error
      Text="Native project not found: $(NativeProjectPath)"
      Condition="!Exists('$(NativeProjectPath)')" />

    <Message Importance="High"
             Text="Building native project '$(NativeProjectPath)' for $(Configuration)|$(NativePlatform)" />

    <MSBuild
      Projects="$(NativeProjectPath)"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(NativePlatform)" />
  </Target>

  <Target Name="Photino_CopyNativeLibs_Windows"
          AfterTargets="Build"
          Condition="'$(PhotinoX_UseLocalProjects)' == 'true'
                   AND '$(IsWindows)' == 'true'
                   AND '$(NativePlatform)' != ''
                   AND '$(TargetFramework)' != ''
                   AND '$(DesignTimeBuild)' != 'true'">

    <Message Importance="High"
             Text="Copying native libs from '$(NativeOutputDir)' to '$(TargetDir)'" />

    <Error
      Text="Native library not found: $(NativeOutputDir)PhotinoX.Native.dll"
      Condition="!Exists('$(NativeOutputDir)PhotinoX.Native.dll')" />

    <Copy
      SourceFiles="$(NativeOutputDir)PhotinoX.Native.dll"
      DestinationFiles="$(TargetDir)PhotinoX.Native.dll"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="$(NativeOutputDir)PhotinoX.Native.pdb"
      DestinationFiles="$(TargetDir)PhotinoX.Native.pdb"
      SkipUnchangedFiles="true"
      Condition="'$(Configuration)' == 'Debug'
               AND Exists('$(NativeOutputDir)PhotinoX.Native.pdb')" />

    <Copy
      SourceFiles="$(NativeOutputDir)runtimes\win-$(NativeRidArch)\native\WebView2Loader.dll"
      DestinationFiles="$(TargetDir)WebView2Loader.dll"
      SkipUnchangedFiles="true"
      Condition="Exists('$(NativeOutputDir)runtimes\win-$(NativeRidArch)\native\WebView2Loader.dll')" />
  </Target>

</Project>
